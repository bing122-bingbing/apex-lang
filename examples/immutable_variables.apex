# Immutable Variables

immutable var MAX_SIZE: int = 100;
immutable var APP_NAME: string = "Apex Engine";
immutable var VERSION: float = 2.0;

print("Max size: ");
print(MAX_SIZE);

print("App name: ");
print(APP_NAME);

print("Version: ");
print(VERSION);

# Trying to modify immutable will cause error
# MAX_SIZE = 200;  # Error!
