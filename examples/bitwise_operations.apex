# Bitwise Operations in Apex

var a: int = 12;  # 1100 in binary
var b: int = 10;  # 1010 in binary

print("a & b (AND):");
print(a & b);

print("a | b (OR):");
print(a | b);

print("a ^ b (XOR):");
print(a ^ b);

print("~a (NOT):");
print(~a);

print("a << 2 (Left Shift):");
print(a << 2);

print("a >> 2 (Right Shift):");
print(a >> 2);
